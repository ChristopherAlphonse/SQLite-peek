{
  "name": "sqlite-peek",
  "displayName": "SQLite Peek",
  "description": "Free, read-only SQLite viewer for VS Code: browse tables and views, page through rows, and run SQL queries without modifying the file.",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0b3a7a",
    "theme": "dark"
  },
  "version": "1.0.0",
  "publisher": "christopheralphonse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristopherAlphonse/sqlite-viewer-local"
  },
  "homepage": "https://github.com/ChristopherAlphonse/sqlite-viewer-local#readme",
  "bugs": {
    "url": "https://github.com/ChristopherAlphonse/sqlite-viewer-local/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sqlitePeek.viewer",
        "displayName": "SQLite Peek",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          },
          {
            "filenamePattern": "*.db3"
          },
          {
            "filenamePattern": "*.s3db"
          },
          {
            "filenamePattern": "*.sl3"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "scripts": {
    "package": "npx -y @vscode/vsce@3 package -o sqlite-peek.vsix"
  },
  "keywords": [
    "sqlite",
    "sqlite3",
    "database",
    "db",
    "sql",
    "viewer",
    "table",
    "browser"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
