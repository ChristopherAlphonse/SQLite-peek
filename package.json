{
  "name": "sqlite-viewer-local",
  "displayName": "SQLite Viewer (Local)",
  "description": "Free, read-only SQLite viewer: browse tables and run queries.",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristopherAlphonse/sqlite-viewer-local"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "localSqlite.viewer",
        "displayName": "SQLite Viewer (Local)",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          },
          {
            "filenamePattern": "*.db3"
          },
          {
            "filenamePattern": "*.s3db"
          },
          {
            "filenamePattern": "*.sl3"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "scripts": {
    "package": "npx -y @vscode/vsce package -o sqlite-viewer-local.vsix"
  }
}
